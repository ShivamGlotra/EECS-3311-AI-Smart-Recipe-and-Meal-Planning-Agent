# Copy this file to ".env" in the project folder and fill in what you need.
# ".env" is git-ignored, so your key stays on your machine and is never pushed.
# Variables set in the terminal or IDE override the values here.

# Which AI to use at start-up: auto (default) | mock | anthropic | gemini | ollama
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, otherwise the offline mock
SMARTPLATE_AI_PROVIDER=auto

# Claude (Anthropic API) - get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# SMARTPLATE_AI_MODEL=claude-opus-5-5

# Gemini (Google) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Local model through Ollama (no key needed) - use with SMARTPLATE_AI_PROVIDER=ollama
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_URL=http://localhost:11434
