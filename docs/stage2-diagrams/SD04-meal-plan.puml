@startuml SmartPlate_Stage2_SD04_MealPlan
' SD04 (updated in Stage 2) - AI Weekly Meal Plan Creation (F05 / UC05)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
title SD04 (updated in Stage 2) - AI Weekly Meal Plan Creation (F05 / UC05)

actor User
participant "MealPlannerGUI /\nMealPlannerCLI" as UI
participant SmartRecipeFacade as F
participant MealPlanningAgent as A
participant RequestConstraints as RC #E3F2FD
participant RecipeRepository as R
participant RecipeSelectionStrategy as S
participant AIModel as M
participant MealPlan as P
participant ConstraintValidator as V

User -> UI : enter planning request
UI -> F : createMealPlan(request)
F -> A : createPlan(request, profile, pantry)
A -> RC : parse(request)
A -> RC : applyTo(profile)
RC --> A : effective profile
A -> RC : planDays()
alt not 5 to 7 days
  RC --> A : error ("A plan must have 5 to 7 days")
  A --> F : error
  F --> UI : display message
else 5 to 7 days
  A -> R : findAll()
  A -> S : selectRecipes(recipes, effective, pantry)
  S --> A : candidates (max 15)
  loop at most 2 attempts (first answer + one revision)
    A -> M : generate(prompt with DAYS, CANDIDATES, EXCLUDE, PREVIOUS_VIOLATIONS)
    alt AI service fails
      M --> A : AIServiceException
      A --> F : error
      F --> UI : display message
    else AI responds
      M --> A : "Monday: id" ... one line per day
      loop each day
        A -> R : findById(id)
        A -> P : addMeal(new PlannedMeal(day, recipe, servings))
      end
      A -> V : validatePlan(plan, effective)
      V --> A : ValidationResult (missing days, allergens, dislikes, diet, time)
    end
  end
  alt valid plan
    A --> F : MealPlan
    F -> F : store plan, clear undo history
    F --> UI : display weekly plan + agent trace
  else no valid plan after the revision
    A --> F : failure reported
    F --> UI : display message
  end
end
@enduml
