@startuml SmartPlate_Stage2_SD03_Recommendation
' SD03 (updated in Stage 2) - AI Recipe Recommendation (F04 / UC04)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
title SD03 (updated in Stage 2) - AI Recipe Recommendation (F04 / UC04)

actor User
participant "MealPlannerGUI /\nMealPlannerCLI" as UI
participant SmartRecipeFacade as F
participant MealPlanningAgent as A
participant RequestConstraints as RC #E3F2FD
participant RecipeRepository as R
participant RecipeSelectionStrategy as S
participant AIModel as M
participant ConstraintValidator as V

User -> UI : enter request
UI -> F : recommendRecipes(request)
F -> A : recommend(request, profile, pantry)
note right of A #E3F2FD : one AIModel is used for the whole request\n(a switch applies to the next request)
A -> RC : parse(request)
RC --> A : constraints ("vegetarian", "avoid red onion", "under 30 min", "3 ideas")
A -> RC : applyTo(profile)
RC --> A : effective profile (profile + request constraints)
A -> R : findAll()
R --> A : List<Recipe>
A -> S : selectRecipes(recipes, effective, pantry)
S --> A : candidates (max 15)
alt no candidate fits
  A --> F : error (reported before calling the AI)
  F --> UI : display message
else candidates found
  loop at most 2 attempts (first answer + one revision)
    A -> M : generate(prompt with CANDIDATES, EXCLUDE, PREVIOUS_VIOLATIONS)
    alt AI service fails
      M --> A : AIServiceException
      A --> F : error
      F --> UI : display message
    else AI responds
      M --> A : "RECIPES: id, id, ..."
      A -> R : findById(id)
      note right of A : unknown id -> violation + EXCLUDE
      A -> V : validateRecipe(recipe, effective)
      V --> A : ValidationResult
      note right of A : stop when the answer has no violations
    end
  end
  alt valid recommendations
    A --> F : List<Recipe>
    F --> UI : recommendations + agent trace
  else still invalid after the revision
    A --> F : the valid part, or failure reported
    F --> UI : display message
  end
end
@enduml
