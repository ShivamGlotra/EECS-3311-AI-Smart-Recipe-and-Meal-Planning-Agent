@startuml SmartPlate_Stage2_ClassDiagram
' SmartPlate - class diagram of the implemented system (Stage 2).
' Render: java -jar plantuml.jar -tpng docs/stage2-diagrams/*.puml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam classFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #4A5468
skinparam ArrowColor #4A5468
skinparam PackageBorderColor #8A93A5
skinparam linetype ortho
title SmartPlate - class diagram of the implemented system (Stage 2)\nBlue = added during implementation (not in the Stage 1 diagram)

package "presentation" {
  class MealPlannerGUI {
    +start()
    +buildContent() : JComponent
    -statusArea(assistant) : JComponent
    -modelSwitcher() : JComboBox
  }
  class MealPlannerCLI {
    +runLoop()
  }
  package "gui" #F7F8FA {
    class AssistantPanel #E3F2FD {
      +createPlan() / recommend() / editPlan() / undo()
      +onBusyChange(listener)
      +refreshPlan()
    }
    class RecipesPanel #E3F2FD
    class PantryPanel #E3F2FD
    class PreferencesPanel #E3F2FD
    interface TaskRunner #E3F2FD {
      +run(task, onSuccess, onFailure)
    }
  }
}

package "facade" {
  class SmartRecipeFacade <<Facade>> {
    -profile : UserProfile
    -pantry : Pantry
    -currentPlan : MealPlan
    +setupProfile(profile) : UserProfile
    +managePantry(action, item) : Pantry
    +searchRecipes(query) : List<Recipe>
    +recommendRecipes(request) : List<Recipe>
    +createMealPlan(request) : MealPlan
    +editMealPlan(request) : MealPlan
    +undoLastChange() : MealPlan
    +adjustServings(recipe, servings) : Recipe
    +substituteIngredient(recipe, ingredient) : Recipe
    +calculateRecipeNutrition(recipe) : NutritionInfo
    +calculatePlanNutrition() : NutritionInfo
    +generateShoppingList() : ShoppingList
    +setStrategy(name)
    +setAIProvider(provider)
    +getAIProviders() : List<String>
    +getLastAgentTrace() : List<String>
  }
}

package "agent" {
  class MealPlanningAgent <<Strategy context, Adapter client>> {
    -aiModel : AIModel
    -strategy : RecipeSelectionStrategy
    +recommend(request, profile, pantry) : List<Recipe>
    +createPlan(request, profile, pantry) : MealPlan
    +editPlan(request, plan, profile, pantry) : Command
    +setStrategy(strategy)
    +setAIModel(model)
    +getLastTrace() : List<String>
  }
  class ConstraintValidator {
    +validateRecipe(recipe, profile) : ValidationResult
    +validatePlan(plan, profile) : ValidationResult
  }
  class ValidationResult {
    -violations : List<String>
    +isValid() : boolean
  }
  class RequestConstraints #E3F2FD {
    +parse(request) : RequestConstraints
    +planDays() : int
    +getAvoid() : List<String>
    +applyTo(profile) : UserProfile
  }
}

package "ai" {
  interface AIModel <<Adapter target>> {
    +generate(prompt : String) : String
    +getName() : String
  }
  class AIAdapter <<Adapter>> {
    +generate(prompt) : String
  }
  class AIClient <<Adaptee>> {
    +sendRequest(MessageCreateParams) : Message
  }
  class GeminiAdapter <<Adapter>> #E3F2FD {
    +generate(prompt) : String
  }
  class OllamaAdapter <<Adapter>> #E3F2FD {
    +generate(prompt) : String
  }
  class MockAIModel {
    +generate(prompt) : String
    +scripted(answers) : MockAIModel
  }
  class AIModelFactory <<Factory>> #E3F2FD {
    +create(env) : AIModel
    +forProvider(provider, env) : AIModel
    +missingSetting(provider, env) : String
  }
  class EnvFile #E3F2FD {
    +load() : Map<String, String>
  }
  class PromptFormat #E3F2FD {
    +field(text, key) : String
  }
}

package "strategy" {
  interface RecipeSelectionStrategy <<Strategy>> {
    +selectRecipes(recipes, profile, pantry) : List<Recipe>
  }
  class PantryFirstStrategy
  class FastestMealStrategy
}

package "command" {
  interface Command <<Command>> {
    +execute()
    +undo()
  }
  class ReplaceMealCommand {
    -day : String
    -oldMeal : PlannedMeal
    -newMeal : PlannedMeal
  }
  class CommandHistory <<Invoker>> {
    +execute(command)
    +undo() : Command
    +canUndo() : boolean
  }
}

package "plan" {
  interface PlanComponent <<Component>> {
    +getNutrition() : NutritionInfo
    +getIngredients() : List<RecipeIngredient>
    +getCookingTime() : int
  }
  class MealPlan <<Composite>> {
    +addMeal(meal)
    +replaceMeal(day, meal)
    +getMeal(day) : PlannedMeal
  }
  class PlannedMeal <<Leaf>> {
    -day : String
    -servings : int
  }
  class Days #E3F2FD {
    +normalize(text) : String
    +findIn(text) : String
  }
}

package "service" {
  class RecipeRepository {
    +search(query) : List<Recipe>
    +findById(id) : Recipe
    +findAll() : List<Recipe>
  }
  class NutritionService
  class ServingScaler
  class SubstitutionService
  class ShoppingListService
  class SampleData #E3F2FD
}

package "domain" {
  class UserProfile {
    +validate() : List<String>
    +withRequestConstraints(diets, dislikes, maxTime) : UserProfile
  }
  class Pantry
  class PantryItem
  enum PantryAction {
    ADD
    UPDATE
    REMOVE
  }
  class Recipe
  class RecipeIngredient
  class Ingredient
  class NutritionInfo
  class ShoppingList {
    +consolidate()
    +roundUpQuantities() : boolean
  }
  class ShoppingItem
  class Substitution
  class DietRules #E3F2FD {
    +conflicts(ingredient, profile) : List<String>
    +matchesDislike(ingredient, term) : boolean
  }
  class Units #E3F2FD
}

' presentation -> facade only
MealPlannerGUI --> SmartRecipeFacade
MealPlannerCLI --> SmartRecipeFacade
MealPlannerGUI *-- AssistantPanel
MealPlannerGUI *-- RecipesPanel
MealPlannerGUI *-- PantryPanel
MealPlannerGUI *-- PreferencesPanel
AssistantPanel --> SmartRecipeFacade
AssistantPanel --> TaskRunner

' facade -> subsystems
SmartRecipeFacade --> MealPlanningAgent
SmartRecipeFacade --> CommandHistory
SmartRecipeFacade --> RecipeRepository
SmartRecipeFacade --> NutritionService
SmartRecipeFacade --> ServingScaler
SmartRecipeFacade --> SubstitutionService
SmartRecipeFacade --> ShoppingListService
SmartRecipeFacade ..> AIModelFactory : switch model
SmartRecipeFacade --> UserProfile
SmartRecipeFacade --> Pantry
SmartRecipeFacade --> MealPlan

' agent
MealPlanningAgent --> AIModel
MealPlanningAgent --> RecipeSelectionStrategy
MealPlanningAgent --> ConstraintValidator
MealPlanningAgent --> RecipeRepository
MealPlanningAgent ..> RequestConstraints
MealPlanningAgent ..> PromptFormat
MealPlanningAgent ..> ReplaceMealCommand : creates
ConstraintValidator ..> ValidationResult
ConstraintValidator ..> DietRules

' adapter
AIModel <|.. AIAdapter
AIModel <|.. GeminiAdapter
AIModel <|.. OllamaAdapter
AIModel <|.. MockAIModel
AIAdapter --> AIClient
AIModelFactory ..> AIModel : creates
AIModelFactory ..> EnvFile

' strategy
RecipeSelectionStrategy <|.. PantryFirstStrategy
RecipeSelectionStrategy <|.. FastestMealStrategy
RecipeSelectionStrategy ..> DietRules

' command
Command <|.. ReplaceMealCommand
CommandHistory o-- "0..*" Command
ReplaceMealCommand --> MealPlan

' composite
PlanComponent <|.. MealPlan
PlanComponent <|.. PlannedMeal
MealPlan o-- "5..7" PlannedMeal
PlannedMeal --> Recipe
MealPlan ..> Days

' services and domain
RecipeRepository o-- "0..*" Recipe
NutritionService ..> PlanComponent
ShoppingListService ..> PlanComponent
ShoppingListService ..> ShoppingList
SubstitutionService o-- "0..*" Substitution
SubstitutionService ..> DietRules
RecipeRepository ..> SampleData
Recipe o-- "1..*" RecipeIngredient
Recipe --> NutritionInfo
RecipeIngredient --> Ingredient
Pantry o-- "0..*" PantryItem
PantryItem --> Ingredient
ShoppingList o-- "0..*" ShoppingItem
ShoppingItem --> Ingredient
Substitution --> Ingredient
@enduml
