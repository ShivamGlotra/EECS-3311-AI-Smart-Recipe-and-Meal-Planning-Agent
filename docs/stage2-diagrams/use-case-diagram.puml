@startuml SmartPlate_Stage2_UseCase
' SmartPlate - use cases of the implemented system (Stage 2). UC11 is new.
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #4A5468
skinparam ArrowColor #4A5468
title SmartPlate - use cases of the implemented system (Stage 2)\nBlue = new in Stage 2

actor User
actor "AI Service\n(Claude, Gemini or local Ollama)" as AI

rectangle "SmartPlate (GUI and CLI)" {
  usecase "UC01 Manage Preferences" as UC01
  usecase "UC02 Manage Pantry" as UC02
  usecase "UC03 Search Recipes" as UC03
  usecase "UC04 Get AI Recipe Recommendations" as UC04
  usecase "UC05 Create Weekly Meal Plan" as UC05
  usecase "UC06 Edit Meal Plan and Undo Changes" as UC06
  usecase "UC07 Adjust Serving Size" as UC07
  usecase "UC08 Substitute Ingredient" as UC08
  usecase "UC09 Calculate Nutrition" as UC09
  usecase "UC10 Generate Shopping List" as UC10
  usecase "UC11 Select AI Model" as UC11 #E3F2FD
}

User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
User --> UC10
User --> UC11
UC04 --> AI
UC05 --> AI
UC06 --> AI
UC11 ..> AI : chooses which
@enduml
